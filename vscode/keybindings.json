[
    // Ctrl+Alt+H : header 42. REST Client (humao.rest-client) prend le même
    // raccourci pour son historique : on le lui retire.
    {
        "key": "ctrl+alt+h",
        "command": "-rest-client.history"
    },
    {
        "key": "ctrl+alt+h",
        "command": "42header.insertHeader",
        "when": "editorTextFocus"
    },
    // F7 : reformater le fichier C à la norme (comme dans vim)
    {
        "key": "f7",
        "command": "workbench.action.tasks.runTask",
        "args": "42: format (c_formatter_42)",
        "when": "editorLangId == c"
    },
    // Ctrl+Alt+R : tout vérifier avant de rendre
    {
        "key": "ctrl+alt+r",
        "command": "workbench.action.tasks.runTask",
        "args": "42: avant rendu",
        "when": "editorLangId != http && editorLangId != plaintext"
    },
    // F8 : norminette sur le fichier courant
    {
        "key": "f8",
        "command": "workbench.action.tasks.runTask",
        "args": "42: norminette (fichier)",
        "when": "editorLangId == c"
    }
]
